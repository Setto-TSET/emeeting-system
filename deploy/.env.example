# คัดลอกเป็น deploy/.env บน VM แล้วเติมค่าจริง (ห้าม commit)

# โดเมนของ backend — Caddy จะขอใบรับรอง TLS ให้อัตโนมัติ
# ยังไม่มีโดเมน ให้ใส่ :80 เพื่อทดสอบ http ในเครื่องก่อน
SITE_ADDRESS=api.example.com

# ทุกโดเมนที่หน้าเว็บถูกเสิร์ฟ คั่นด้วย comma — ทั้ง REST และ WebSocket ใช้ค่านี้
CORS_ORIGIN=https://meeting-system-features-40fa4d.vercel.app,http://localhost:3000

# MySQL — DB_PASSWORD คือรหัส root ของ container ตั้งให้ยาวและสุ่ม
DB_PASSWORD=
DB_NAME=emeeting_db

# สุ่มอย่างน้อย 32 ตัวอักษร ห้ามใช้ค่าเดียวกับ dev
# สร้าง: openssl rand -base64 48
JWT_SECRET=

# Claude API สำหรับสรุปการประชุม (ไม่ใส่ = ปิดฟีเจอร์สรุป)
ANTHROPIC_API_KEY=

# ที่อยู่ของ ASR sidecar — ค่าเริ่มต้นชี้ไปที่ service ใน compose เดียวกัน
ASR_URL=http://asr:8000
