# คัดลอกเป็น deploy/koyeb.env แล้วเติมค่าจริง (ห้าม commit)

# MySQL ภายนอก (Aiven) — copy Service URI จาก Aiven console
# ต้องตัด ?ssl-mode=REQUIRED ออก แล้วใส่ ssl แบบ JSON ของ mysql2 แทน
# ตัวอย่าง:
# DATABASE_URL=mysql://avnadmin:PASS@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl={"rejectUnauthorized":false}
DATABASE_URL=

# สุ่มอย่างน้อย 32 ตัวอักษร: openssl rand -base64 48
JWT_SECRET=

# โดเมนหน้าเว็บทั้งหมด คั่นด้วย comma (REST + WebSocket ใช้ค่านี้)
CORS_ORIGIN=https://meeting-system-features-40fa4d.vercel.app,http://localhost:3000

# ว่างได้ = ปิดฟีเจอร์สรุปประชุม
CLAUDE_API_KEY=

# ตัวเลือก Koyeb (มีค่าเริ่มต้นให้แล้ว)
KOYEB_APP=emeeting
KOYEB_SERVICE=backend
KOYEB_REGION=sin
KOYEB_INSTANCE=nano
KOYEB_GIT_REPO=github.com/Setto-TSET/emeeting-system
KOYEB_GIT_BRANCH=master
