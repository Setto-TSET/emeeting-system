{
  "name": "emeeting-backend",
  "version": "1.0.0",
  "description": "Backend for e-Meeting System — transcription + AI summarization",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/database/schema.sql','dist/database/schema.sql')\"",
    "start": "node dist/server.js",
    "migrate": "ts-node src/database/migrations.ts",
    "test": "jest"
  },
  "keywords": [
    "meeting",
    "transcription",
    "summarization",
    "ai"
  ],
  "author": "e-Meeting Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.10.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.8.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
