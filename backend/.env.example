# ═══════════════════════════════════════
# Backend Configuration
# ═══════════════════════════════════════
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า

# Server
PORT=3001
NODE_ENV=production

# ต้องระบุทุกโดเมนที่หน้าเว็บถูกเสิร์ฟ คั่นด้วย comma — ทั้ง REST และ WebSocket ใช้ค่านี้
CORS_ORIGIN=https://meeting-system-features-40fa4d.vercel.app,http://localhost:3000

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=emeeting_db
# DATABASE_URL=mysql://user:pass@host:port/db  (Railway: takes priority over DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME above when set)

# ต้องเป็นค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร ห้ามใช้ค่าเดียวกับ dev
JWT_SECRET=

# ใช้ครั้งเดียวตอนรัน npm run seed — ห้ามเก็บไว้ใน production env
SEED_PASSWORD=

# Claude API สำหรับสรุปการประชุม
ANTHROPIC_API_KEY=

# หมายเหตุ: ZEGO_APP_ID / ZEGO_SERVER_SECRET ไม่ได้อยู่ที่นี่ —
# ตั้งใน .env.local ของแอป Next.js เพราะ video token ออกจาก Next.js API route โดยตรง
