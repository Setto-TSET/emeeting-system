# ═══════════════════════════════════════
# Backend Configuration
# ═══════════════════════════════════════
# Copy this file to .env and fill in values

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=emeeting_db
# DATABASE_URL=mysql://user:pass@host:port/db  (Railway: takes priority over DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME above when set)

# STT provider (TBD — AssemblyAI/Azure ถ้าต้องการความแม่นยำสูงกว่า Web Speech API)
# STT_API_KEY=your_stt_provider_key

# หมายเหตุ: ZEGO_APP_ID / ZEGO_SERVER_SECRET / ZEGO_SERVER_URL ไม่ได้อยู่ที่นี่ —
# ตั้งใน .env.local ของแอป Next.js (root ของโปรเจกต์) เพราะ video token
# ออกจาก Next.js API route โดยตรง ไม่ผ่าน backend/ นี้

# Claude API (สำหรับสรุปประชุม)
CLAUDE_API_KEY=sk-ant-your_api_key

# JWT (สำหรับ authentication)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=7d

# Transcription (polling interval)
TRANSCRIPT_POLL_INTERVAL_MS=30000
TRANSCRIPT_MAX_RETRIES=20

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Logging
LOG_LEVEL=debug
