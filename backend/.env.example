# ═══════════════════════════════════════
# Backend Configuration
# ═══════════════════════════════════════
# Copy this file to .env and fill in values

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=emeeting_db

# Webex Integration (จาก Webex Developer Portal)
WEBEX_CLIENT_ID=your_client_id
WEBEX_CLIENT_SECRET=your_client_secret
WEBEX_BOT_TOKEN=your_bot_token
WEBEX_ORG_ID=your_org_id

# Webex Admin Account (สำหรับเรียกร้าง token)
WEBEX_ADMIN_EMAIL=admin@yourorg.webex.com

# Claude API (สำหรับสรุปประชุม)
CLAUDE_API_KEY=sk-ant-your_api_key

# JWT (สำหรับ authentication)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=7d

# Transcription (polling interval)
TRANSCRIPT_POLL_INTERVAL_MS=30000
TRANSCRIPT_MAX_RETRIES=20

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Logging
LOG_LEVEL=debug
