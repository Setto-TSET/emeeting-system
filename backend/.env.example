# ═══════════════════════════════════════
# Backend Configuration
# ═══════════════════════════════════════
# Copy this file to .env and fill in values

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=emeeting_db

# ZegoCloud (จาก ZegoCloud Console > โปรเจกต์ > การกำหนดค่าโปรเจกต์)
ZEGO_APP_ID=your_app_id
ZEGO_SERVER_SECRET=your_32_char_server_secret
ZEGO_SERVER_URL=wss://webliveroom<APP_ID>-api.coolzcloud.com/ws

# Claude API (สำหรับสรุปประชุม)
CLAUDE_API_KEY=sk-ant-your_api_key

# JWT (สำหรับ authentication)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=7d

# Transcription (polling interval)
TRANSCRIPT_POLL_INTERVAL_MS=30000
TRANSCRIPT_MAX_RETRIES=20

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Logging
LOG_LEVEL=debug
