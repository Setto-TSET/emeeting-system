# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local — .gitignore กันไว้แล้ว)

# ZegoCloud — จาก ZegoCloud Console > โปรเจกต์ > การกำหนดค่าโปรเจกต์
# ใช้สำหรับออก token วิดีโอห้องประชุมจริง (POST /api/video/token)
# ไม่มีค่าพวกนี้ = ระบบจะเชื่อมต่อวิดีโอไม่สำเร็จ (ไม่มี mock ให้ fallback แล้ว)
ZEGO_APP_ID=your_app_id
ZEGO_SERVER_SECRET=your_32_char_server_secret
ZEGO_SERVER_URL=wss://webliveroom<APP_ID>-api.coolzcloud.com/ws

# ── ฐานข้อมูล (Prisma) ───────────────────────────────
# ใช้ MySQL ตัวเดียวกับ backend/ (ค่าเดียวกับ DB_* ใน backend/.env)
DATABASE_URL="mysql://root:your_db_password@localhost:3306/emeeting_db"

# ── Session (JWT ใน httpOnly cookie) ─────────────────
# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างด้วย: openssl rand -base64 48
# เปลี่ยนค่านี้ = ทุกคนที่ล็อกอินค้างอยู่หลุด session ทันที
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
